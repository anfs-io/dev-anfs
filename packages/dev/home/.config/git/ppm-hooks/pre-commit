#!/usr/bin/env bash
# pre-commit hook for anfs source repos: bump the patch version of every resource this commit
# touches, create the manifest of a resource that has none, and refuse a commit that would leave
# a resource without its manifest, or with one that isn't valid YAML.
#
# A resource is a directory with a manifest named for its kind (lib/package-meta.sh, META_KINDS):
# packages/<p>/package.yml, containers/<c>/container.yml, machines/<m>/machine.yml,
# machines/images/<i>/image.yml, machines/networks/<n>/network.yml, stacks/<s>/stack.yml.
#
# Bumps at most once per unpushed series. A resource whose version already differs from the
# version at the push base has been bumped since the last push, so it is left alone — which
# also means `git commit --amend` and a run of commits before one push produce a single bump,
# and a version you set by hand is respected. A repo with nothing pushed yet (no upstream and
# no remote branch) has had zero pushes, so it gets zero bumps: a new resource settles at 0.1.0
# and stays there until its first push.
#
# Wired up by `anfs hooks install` (anfs-dev/dev), which points a repo's core.hooksPath at this
# directory. Note that core.hooksPath replaces a repo's .git/hooks entirely.
set -euo pipefail
# The bash floor: git starts this with whatever bash PATH finds (lib/anfs/bash.sh)
# shellcheck source=/dev/null
if [[ -f "$HOME/.local/lib/anfs/bash.sh" ]]; then source "$HOME/.local/lib/anfs/bash.sh"; fi

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -f "$HOOK_DIR/lib/package-meta.sh" ]]; then
  source "$HOOK_DIR/lib/package-meta.sh"
else
  echo "meta: package-meta.sh not found next to the hook, skipping version bump" >&2
  exit 0
fi

# Every resource directory has its manifest. Checked against the index, after the loop below
# has created and staged any that were missing, so what is left is a manifest deleted on its own
# or a resource that predates this hook.
check_manifests() {
  local missing dir manifest yml bad=""
  missing=$(git ls-files | meta_resources | while read -r dir manifest; do
    git cat-file -e ":$dir/$manifest" 2>/dev/null || echo "$dir/$manifest"
  done)
  if [[ -n "$missing" ]]; then
    echo "meta: every resource needs its manifest; missing:" >&2
    printf '  %s\n' $missing >&2
    exit 1
  fi

  # yq is ppm's, not the hook's: validate when it is there
  command -v yq >/dev/null 2>&1 || return 0
  while read -r dir manifest; do
    yml="$dir/$manifest"
    git cat-file -e ":$yml" 2>/dev/null || continue
    [[ -n "$(git diff --cached --name-only --diff-filter=ACMR -- "$yml")" ]] || continue
    if [[ "$manifest" == package.yml ]]; then
      git show ":$yml" | yq -e 'tag == "!!map" and ((.categories // []) | tag == "!!seq")' >/dev/null 2>&1 ||
        bad="$bad"$'\n'"  $yml (a YAML map; categories, if present, a list)"
    else
      git show ":$yml" | yq -e 'tag == "!!map"' >/dev/null 2>&1 || bad="$bad"$'\n'"  $yml (a YAML map)"
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMR | meta_resources)
  if [[ -n "$bad" ]]; then
    echo "meta: not a valid manifest:$bad" >&2
    exit 1
  fi
}

# A commit that only deletes still gets checked: deleting a manifest alone is what it catches
[[ -n "$(git diff --cached --name-only | meta_resources)" ]] || exit 0
staged=$(git diff --cached --name-only --diff-filter=ACMR | meta_resources)

base=$(meta_push_base)

while read -r dir manifest; do
  [[ -n "$dir" ]] || continue
  [[ -d "$REPO_ROOT/$dir" ]] || continue          # deleted resource
  meta_file="$REPO_ROOT/$dir/$manifest"

  base_version=""
  [[ -n "$base" ]] && base_version=$(meta_version_at "$base" "$dir/$manifest")
  current=$(meta_read "$meta_file" version)

  if [[ ! -f "$meta_file" ]]; then
    meta_bootstrap "$meta_file"
    echo "meta: $dir — created $manifest at 0.1.0"
  elif [[ -z "$current" ]]; then
    meta_bump_patch "$meta_file" >/dev/null
    echo "meta: $dir — $manifest had no version, set 0.1.0"
  elif [[ -z "$base" ]]; then
    echo "meta: $dir — nothing pushed yet ($current), not bumping"
    continue
  elif [[ -z "$base_version" ]]; then
    echo "meta: $dir — new at $current, not bumping until it is pushed"
    continue
  elif [[ "$base_version" != "$current" ]]; then
    echo "meta: $dir — already $current since $base_version was pushed, not bumping"
    continue
  else
    new_version=$(meta_bump_patch "$meta_file")
    if [[ -z "$new_version" ]]; then
      echo "meta: $dir — version '$current' is not semver, leaving it alone"
      continue
    fi
    echo "meta: $dir — bumped to $new_version"
  fi

  git add "$meta_file"
done <<< "$staged"

check_manifests
