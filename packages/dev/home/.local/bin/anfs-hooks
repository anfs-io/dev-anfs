#!/usr/bin/env bash
# anfs hooks — wire the package-versioning git hooks into the sources' repos (anfs-dev/dev)
#
# Run as `anfs hooks ...`: anfs runs anfs-<name> from ~/.local/bin for a command it does not
# declare itself. It acts on the sources' repos, not on packages, so it is anfs's and not ppm's.
#
# Each repo gets core.hooksPath pointed at the stowed hook directory, set per repo. It is never
# set globally: a global core.hooksPath applies to every repo on the machine AND suppresses each
# repo's own .git/hooks, which would silently disable husky/lefthook/overcommit everywhere else.
# Pointing at the stowed path (rather than into the package) means edits to a hook take effect
# everywhere at once, and a higher-priority layer can override a single hook file through stow.
set -euo pipefail

HOOKS_SELF="${BASH_SOURCE[0]}"
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" || ! -f "$ANFS_LIB/cli.sh" ]]; then
  echo "anfs hooks: $ANFS_LIB is missing or out of date; install core/anfs again" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"

CLI_TOOL="anfs hooks"
PPM_HOOKS_DIR="$XDG_CONFIG_HOME/git/ppm-hooks"

cli_cmd status "Which repos are wired up. Without names: system.list and this package's source" \
  --opt "--all: Your user.list repos too" --arg "[source...]"
cli_cmd install "Point each repo's core.hooksPath at the hooks" \
  --opt "--all: Your user.list repos too" --arg "[source...]"
cli_cmd uninstall "Unset it again (only where anfs hooks set it)" \
  --opt "--all: Your user.list repos too" --arg "[source...]"
cli_cmd help "Show this help, or a command's" --arg "[command...]"

cli_help_epilogue() {
  cat <<'EOF'
The hooks bump a package's patch version when a commit touches it. Hooks are not carried by git
clone, so install is re-run after 'anfs src add'.
EOF
}

complete_source() {
  local d
  for d in "$ANFS_SOURCES_HOME"/*/; do [[ -d "$d" ]] && basename "$d"; done
  return 0
}

cmd_status()    { _hooks_status "${CLI_OPT[all]:-false}" "$@"; }
cmd_install()   { _hooks_apply set "${CLI_OPT[all]:-false}" "$@"; }
cmd_uninstall() { _hooks_apply unset "${CLI_OPT[all]:-false}" "$@"; }

# Repo aliases listed in one source-list file (the format collect_repos reads)
_hooks_aliases_in() {
  local file="$1" line url name
  [[ -n "$file" && -f "$file" ]] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    read -r url name <<< "$line"
    [[ -z "$name" ]] && name="$(basename "$url" .git)"
    echo "$name"
  done < "$file"
}

# A file's real path, every symlink on the way followed (no realpath on older macOS)
_hooks_real() {
  local p="$1" l
  while [[ -L "$p" ]]; do
    l=$(readlink "$p")
    if [[ "$l" == /* ]]; then p="$l"; else p="$(dirname "$p")/$l"; fi
  done
  (cd -P "$(dirname "$p")" 2>/dev/null && printf '%s/%s\n' "$(pwd)" "${p##*/}")
}

# The alias of the source this package was installed from, found from where the stowed hooks (or
# this script) really live; nothing when that is not one of the sources (a job's worktree, say)
_hooks_own_source() {
  local real root d
  for real in "$(_hooks_real "$PPM_HOOKS_DIR/pre-commit")" "$(_hooks_real "$HOOKS_SELF")"; do
    [[ -n "$real" ]] || continue
    case "$real" in
      */packages/*/home/.config/git/ppm-hooks/pre-commit) root="${real%/packages/*/home/.config/git/ppm-hooks/pre-commit}" ;;
      */packages/*/home/.local/bin/anfs-hooks) root="${real%/packages/*/home/.local/bin/anfs-hooks}" ;;
      *) continue ;;
    esac
    for d in "$ANFS_SOURCES_HOME"/*/; do
      [[ "$(cd -P "$d" 2>/dev/null && pwd)" == "$root" ]] && { basename "$d"; return 0; }
    done
  done
  return 0
}

# The repos to act on: explicit names, else system.list and the source this package came from
# (plus user.list with --all)
_hooks_target_repos() {
  local all="$1"; shift
  if [[ $# -gt 0 ]]; then
    printf '%s\n' "$@"
    return 0
  fi
  {
    _hooks_aliases_in "$ANFS_SYSTEM_LIST"
    _hooks_own_source
    $all && _hooks_aliases_in "$ANFS_USER_LIST"
  } | awk '!seen[$0]++'
}

# Current core.hooksPath for a repo, empty if unset
_hooks_current() {
  git -C "$1" config --local --get core.hooksPath 2>/dev/null || true
}

# set|unset core.hooksPath across the target repos
_hooks_apply() {
  local action="$1" all="$2"; shift 2
  local alias dir current changed=0

  if [[ "$action" == set && ! -d "$PPM_HOOKS_DIR" ]]; then
    anfs_warn "$PPM_HOOKS_DIR does not exist (is anfs-dev/dev installed?)"
    return 1
  fi

  while IFS= read -r alias; do
    [[ -n "$alias" ]] || continue
    dir="$ANFS_SOURCES_HOME/$alias"
    if [[ ! -d "$dir/.git" ]]; then
      anfs_debug "$alias is not a git repo, skipping"
      continue
    fi
    current=$(_hooks_current "$dir")

    if [[ "$action" == set ]]; then
      if [[ "$current" == "$PPM_HOOKS_DIR" ]]; then
        anfs_debug "$alias already wired up"
        continue
      fi
      if [[ -n "$current" ]]; then
        echo "  $alias: leaving its own core.hooksPath alone ($current)"
        continue
      fi
      _hooks_warn_shadowed "$alias" "$dir"
      # Never fatal: a repo can be read-only (containers mount the host's repos that way) and a
      # failure to wire a hook must not abort `ppm install anfs-dev/dev` or skip its tracker
      if ! git -C "$dir" config --local core.hooksPath "$PPM_HOOKS_DIR" 2>/dev/null; then
        echo "  $alias: could not write .git/config (read-only?), skipped"
        continue
      fi
      echo "  $alias: hooks installed"
    else
      # Only ever remove what this set, never a hooksPath the user chose
      [[ "$current" == "$PPM_HOOKS_DIR" ]] || continue
      if ! git -C "$dir" config --local --unset core.hooksPath 2>/dev/null; then
        echo "  $alias: could not write .git/config (read-only?), skipped"
        continue
      fi
      echo "  $alias: hooks removed"
    fi
    changed=$((changed + 1))
  done < <(_hooks_target_repos "$all" "$@")

  [[ $changed -gt 0 ]] || echo "  no changes"
}

# core.hooksPath replaces .git/hooks wholesale, so say so if the repo has real hooks there.
_hooks_warn_shadowed() {
  local alias="$1" dir="$2" found
  found=$(find "$dir/.git/hooks" -maxdepth 1 -type f ! -name '*.sample' 2>/dev/null | wc -l | tr -d ' ')
  [[ "$found" -gt 0 ]] || return 0
  echo "  $alias: note — this now takes precedence over $found existing .git/hooks file(s)"
}

_hooks_status() {
  local all="$1"; shift
  local alias dir current state
  echo "Hook directory: $PPM_HOOKS_DIR$([[ -d "$PPM_HOOKS_DIR" ]] || echo ' (missing)')"
  while IFS= read -r alias; do
    [[ -n "$alias" ]] || continue
    dir="$ANFS_SOURCES_HOME/$alias"
    if [[ ! -d "$dir/.git" ]]; then
      state="not a git repo"
    else
      current=$(_hooks_current "$dir")
      if [[ "$current" == "$PPM_HOOKS_DIR" ]]; then
        state="installed"
      elif [[ -n "$current" ]]; then
        state="its own: $current"
      else
        state="not installed"
      fi
    fi
    printf '  %-12s %s\n' "$alias" "$state"
  done < <(_hooks_target_repos "$all" "$@")
}

cli_dispatch "$@"
